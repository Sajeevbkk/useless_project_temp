# ==========================================
# Comprehensive .gitignore for Fullstack Web
# (Node.js / React + Python / FastAPI)
# ==========================================

# ------------------------------------------
# Operating System Files
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon\r\r
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------
# IDEs & Code Editors
# ------------------------------------------
# Visual Studio Code
.vscode/
*.code-workspace
.history/

# JetBrains (PyCharm, WebStorm, IntelliJ IDEA, CLion, Rider, GoLand, etc.)
.idea/
*.iml
*.iws
*.ipr
.idea_modules/
cmake-build-*/

# Visual Studio / MSBuild
.vs/
*.suo
*.user
*.userosv
*.sln.docstates
*.userprefs
*.ntvs*
*.njsproj
*.sln
Visual[Ss]tudio.csproj.user

# Sublime Text
*.sublime-project
*.sublime-workspace
sftp-config.json

# Vim / Neovim
*.swp
*.swo
*.sw?
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
Session.vim
Sessionx.vim

# Emacs
\#*\#
/.#*
.dir-locals.el
tramp

# Eclipse
.project
.classpath
.settings/
.metadata/

# NetBeans
nbproject/private/
nbbuild/
nbdist/

# JetBrains Fleet
.fleet/

# Xcode
*.xcuserstate
xcuserdata/
*.xcworkspace

# Atom
.atom/

# ------------------------------------------
# Python & FastAPI
# ------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.Python

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit test / coverage reports
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# Type checking / Linters cache
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter Notebooks
.ipynb_checkpoints

# ------------------------------------------
# Node.js & React (Vite)
# ------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite / Build outputs
dist/
dist-ssr/
.vite/
.turbo/
.next/
.nuxt/
.output/
.parcel-cache/

# Package managers
.pnp
.pnp.js
.pnpm-store
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Linter caches
.eslintcache
.stylelintcache
*.tsbuildinfo

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# ------------------------------------------
# Databases & Local Storage
# ------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db3

# ------------------------------------------
# Temporary & Log Files
# ------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.orig
